<Window x:Class="PetroLogStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PetroLogStudio - Petrophysical Well Log Analyzer" 
        Height="840" Width="1240"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnSelectFolder" Content="📁 Select LAS Folder" Height="40" 
                        Click="BtnSelectFolder_Click" FontWeight="Bold" Background="#0D6EFD" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="1" Text="Discovered Well Files:" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="#333"/>
                <ListBox x:Name="ListWells" Grid.Row="2" SelectionChanged="ListWells_SelectionChanged" 
                         BorderBrush="#DEE2E6" Background="White" FontSize="13"/>

                <!-- Quick Well Overview Card -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel x:Name="PanelWellOverview">
                        <TextBlock Text="📊 Well Overview" FontWeight="Bold" FontSize="13" Foreground="#212529" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtWellName" Text="Well: -" FontSize="12" Foreground="#495057" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtWellDepth" Text="Depth: -" FontSize="12" Foreground="#495057" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtWellRows" Text="Samples: -" FontSize="12" Foreground="#495057" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtWellCurves" Text="Curves: -" FontSize="12" Foreground="#495057" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtWellStatus" Text="Status: -" FontSize="12" Foreground="#198754" FontWeight="SemiBold" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <ProgressBar x:Name="BatchProgress" Height="8" Margin="0,0,0,6" Foreground="#198754"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready to process" Foreground="#6C757D" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="8">
            <TabControl x:Name="TabMainView" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Plot Preview -->
                <TabItem Header="📈 Composite Plot" FontSize="13" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Zoom & View Control Toolbar -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" x:Name="ToolbarControls">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="BtnZoomOut" Content="➖" Width="30" Height="28" Margin="0,0,4,0" 
                                            Click="BtnZoomOut_Click" ToolTip="Zoom Out (or Ctrl + Scroll Down)" Background="White" BorderBrush="#CED4DA" Cursor="Hand"/>
                                    
                                    <Slider x:Name="SliderZoom" Width="110" VerticalAlignment="Center" Margin="4,0"
                                            Minimum="0.1" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.2"
                                            ValueChanged="SliderZoom_ValueChanged"/>
                                    
                                    <Button x:Name="BtnZoomIn" Content="➕" Width="30" Height="28" Margin="4,0,8,0" 
                                            Click="BtnZoomIn_Click" ToolTip="Zoom In (or Ctrl + Scroll Up)" Background="White" BorderBrush="#CED4DA" Cursor="Hand"/>
                                    
                                    <TextBlock x:Name="TxtZoomLevel" Text="100%" VerticalAlignment="Center" Width="45" FontWeight="SemiBold" Foreground="#495057"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnFitWidth" Content="↔ Fit Width" Height="28" Padding="10,0" Margin="4,0" 
                                            Click="BtnFitWidth_Click" ToolTip="Fit plot horizontally to window width" Background="White" BorderBrush="#CED4DA" Cursor="Hand" FontWeight="Medium"/>
                                    <Button x:Name="BtnFitWindow" Content="↕ Fit Window" Height="28" Padding="10,0" Margin="4,0" 
                                            Click="BtnFitWindow_Click" ToolTip="Fit entire plot in view" Background="White" BorderBrush="#CED4DA" Cursor="Hand"/>
                                    <Button x:Name="BtnActualSize" Content="100%" Width="46" Height="28" Margin="4,0,0,0" 
                                            Click="BtnActualSize_Click" ToolTip="Original 1:1 Resolution" Background="White" BorderBrush="#CED4DA" Cursor="Hand"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Plot Area with Zoom & Pan Support -->
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="TxtNoPlot" Text="Select a well log on the left to preview composite plot" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ADB5BD" FontSize="16" FontWeight="SemiBold"/>
                            <ScrollViewer x:Name="PlotScrollViewer" 
                                          HorizontalScrollBarVisibility="Auto" 
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="PlotScrollViewer_PreviewMouseWheel"
                                          SizeChanged="PlotScrollViewer_SizeChanged">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Image x:Name="ImgPlotPreview" Stretch="None">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="PlotScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Full Diagnostic Report -->
                <TabItem Header="📋 Diagnostic Report" FontSize="13" FontWeight="SemiBold">
                    <Border Margin="0,8,0,0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtDiagnosticLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5" Foreground="#212529" 
                                     TextWrapping="NoWrap" Padding="12"
                                     Text="Select a well log on the left to view diagnostic details."/>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>